# 落片本地开发可以不填任何密钥。下面是代码里会读到的变量。
# 复制为 .env 后按需修改。不要提交 .env，也不要写入真实密钥。

# 登录开关。落片默认关闭：解析和下载不需要账号。
# 部署平台可能会注入 true。那只打开平台自带的 Better Auth，不会变成下载门槛，也不会提高额度。
VITE_AUTH_ENABLED=false

# 设为 true / 1 / yes 时关闭 IP 额度。只给本机调试用，公网不要开。
# LUOPIAN_QUOTA_DISABLED=

# 每个 IP 的额度。留空则用默认值：解析 120 次/天、30 次/10 分钟；下载 40 次/天、10 次/10 分钟。
# 窗口长度默认 600000 毫秒（10 分钟）。
# LUOPIAN_INSPECT_PER_DAY=120
# LUOPIAN_INSPECT_PER_WINDOW=30
# LUOPIAN_DOWNLOAD_PER_DAY=40
# LUOPIAN_DOWNLOAD_PER_WINDOW=10
# LUOPIAN_QUOTA_WINDOW_MS=600000

# Postgres。不设置时，登录相关数据用进程内的 PGLite（重启即失）。下载本身不需要数据库。
# DATABASE_URL=postgres://user:password@localhost:5432/luopian

# Better Auth。公网打开登录时才需要固定密钥和对外地址。
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://example.com

# Grok 登录代理。不填时，预览环境使用代码里的 preview client；正式环境由部署方注入。
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# 有值表示正式部署，没有表示工作区预览。
# GROK_PROJECT_ID=

# 门禁身份（平台可选）。
# GROK_GATE_ORIGIN=

# 连接器（平台功能，落片下载用不到）。
# GROK_CONNECTORS_URL=
# GROK_CONNECTOR_ACCESS_TOKEN=

# 浏览器侧公开变量。
# VITE_PUBLIC_HOSTNAME=
# VITE_STUN_URLS=
# VITE_GROK_EXTENSIONS=
